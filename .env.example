# Public URL registered in Google Cloud as an authorized JavaScript origin.
APP_ORIGIN=http://127.0.0.1:4180

# Google OAuth 2.0 Web application credentials. Keep the real values only in .env.local.
GOOGLE_CLIENT_ID=replace-with-your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-your-client-secret

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
STEAM_KEY_ENCRYPTION_SECRET=replace-with-a-random-32-byte-base64url-key

# Bind directly to loopback. This build does not support deployment behind a reverse proxy.
HOST=127.0.0.1
PORT=4180
DATABASE_PATH=./data/steam.sqlite
